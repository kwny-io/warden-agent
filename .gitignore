# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

# Node / 前端依赖（绝不提交 node_modules）
node_modules/
npm-debug.log*
*.tsbuildinfo

# 测试与工具缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 运行产物（警惕：SQLite 数据库、日志、密钥）
*.db
*.db-journal
*.sqlite
*.sqlite3
local-tmp/
*.log

# 密钥——绝不能提交
.env
*.key
*.pem
# Prometheus 抓取用的 Bearer token（内容 = WARDEN_API_KEY）
deploy/observability/warden_token

# 本地漏洞扫描产物（trivy 的漏洞库缓存很大，镜像导出 tar 也很大——都别提交）
.trivy-cache/
.trivy-img.tar
# 审计导出产物（本机归档用，不入版本库）
audit-exports/

# IDE / 系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# 工具缓存（ZCode 计划存储等）
.zcode/
.mimosa/
