# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
build/

# Node / 前端依赖（绝不提交 node_modules）
node_modules/
npm-debug.log*
*.tsbuildinfo

# 测试与工具缓存
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# 运行产物（警惕：SQLite 数据库、日志、密钥）
*.db
*.db-journal
*.sqlite
*.sqlite3
local-tmp/
*.log

# 密钥——绝不能提交
.env
*.key
*.pem
# Prometheus 抓取用的 Bearer token（内容 = WARDEN_API_KEY）
deploy/observability/warden_token

# 本地漏洞扫描产物（trivy 的漏洞库缓存很大，镜像导出 tar 也很大——都别提交）
.trivy-cache/
.trivy-img.tar
# kubeconform 用的 k8s JSON schema 缓存（本地校验用；CI 里用默认在线源）
.k8s-schemas/
# 审计导出产物（本机归档用，不入版本库）
audit-exports/

# IDE / 系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# 工具缓存（ZCode 计划存储等）
.zcode/
.mimosa/

# 测试/覆盖率产物（本地跑 pytest/mypy/vitest 都会生成；CI 自己算，不靠提交产物）
.vitest/
coverage.json
coverage.xml
htmlcov/
web/coverage/

# Playwright 真浏览器 e2e 产物（失败时的 trace/截图/HTML 报告都很大）
web/test-results/
web/playwright-report/
web/blob-report/
web/.playwright/

# 变异测试产物：mutants/ 里是「每个突变体一份源码副本」，体积远超仓库本身，
# 且每次跑都重新生成——绝不提交（scripts/mutation.sh 会在这里写 stats / 日志）
mutants/

# mutant_check.py 的崩溃残留目录（正常跑完会自动删）
.mutant_check_backup/
