# 复制这份文件为 `.env`，填上你自己的密钥。`.env` 已被 .gitignore 忽略，不会提交。

# 真实 DeepSeek 模型密钥（不设则用离线假模型）
DEEPSEEK_API_KEY=sk-你的密钥放这里

# HTTP 服务端口
PORT=8000

# ---- 阶段13 产品级 HTTP 服务 ----
# 认证：设一个服务端访问密钥 → 业务接口都要带 `Authorization: Bearer <key>`。
# ⚠️ 鉴权是 **fail-closed** 的：既不设下面任何一项、也不设 WARDEN_ALLOW_ANON=1
#    → 服务**拒绝启动**（宁可起不来，也不要无鉴权地对外服务）。
# ⚠️ 这里刻意**不预填**一个占位值：模板里放一个公开可见的 key，等于所有人都知道你的密钥。
#    对外部署请改成强随机串；仅本机临时演示可改用 WARDEN_ALLOW_ANON=1。
# WARDEN_API_KEY=换成一串强随机值
# WARDEN_ALLOW_ANON=1            # 仅本机演示：显式接受无鉴权（且只能监听回环地址）

# 多用户隔离（推荐对外部署用这个，而不是单个 WARDEN_API_KEY）：
# 逗号分隔的 `用户id:密钥`，每个 key 绑定一个身份——客户端传的 ?user_id= 会被忽略，
# 越权访问他人会话返回 403。以下三项与 WARDEN_API_KEY 二选一。
# WARDEN_API_KEYS=alice:sk-alice-xxx,bob:sk-bob-xxx
# WARDEN_API_USER=demo-user    # 单 key 模式下的身份（默认 demo-user）
# WARDEN_TENANT=local          # 租户 id（审计与授权按它隔离）

# 仅本机开发、明确接受"无鉴权"时写这行（对外监听时写它会拒绝启动）
# WARDEN_ALLOW_ANON=1

# 限流：每 60 秒最多 600 次（按调用者/来源 IP 计；设 0 关闭）
# WARDEN_RATE_LIMIT=600/60

# 多副本部署：把幂等表 / SSE 事件流 / 限流计数放进共享存储（同一个库），
# 否则每个副本各算一份 —— 幂等失效、SSE 丢事件、限额翻倍。
# 需要配合 PostgreSQL（SqliteStore 是单机文件，跨主机共享不受支持）。
# WARDEN_SHARED_STATE=1

# ---- RAG 知识库（默认关闭）----
# 1 = 索引内置离线语料；也可以给一个文档目录（索引其下 .md / .markdown / .txt）
# WARDEN_KNOWLEDGE=1
# WARDEN_KNOWLEDGE=D:/docs/company-handbook
#
# 嵌入器：默认是**离线词频哈希**（词面匹配，不是语义检索，不花钱不联网）。
# 想要真语义检索，配齐下面三项走 OpenAI 兼容的 /embeddings 端点
# （必须是公网地址：环回/私网会被拒，防 SSRF）：
# WARDEN_EMBED_BASE_URL=https://你的兼容端点/v1
# WARDEN_EMBED_API_KEY=你的key
# WARDEN_EMBED_MODEL=你的嵌入模型名

# ---- 联网抓取（默认关闭）----
# 开启后 web.fetch 会真的发 HTTP 请求抓网页（Agent 可主动访问公网）。
# 每一跳重定向都会重新过 URL 策略：拒绝内网/环回/保留地址与云元数据端点（169.254.169.254）。
# 但"Agent 能不能出网"应该由你显式决定，所以默认是离线 mock（不发任何请求）。
# WARDEN_WEB_FETCH=1

# 出站限速/配额：限制"Agent 主动往外发请求"的**总量**（默认开启）。
# 单次请求的超时/体积上限只界定"一次"，不界定"多少次"——没有这层，模型一轮抓 50 个链接、
# 并发用户相乘、或把某个站点打到 429，都没有东西拦。
# 格式均为 `次数/窗口秒数`；填 0 关闭该项。
# WARDEN_OUTBOUND_LIMIT=120/60         # 全局：每 60 秒最多 120 次出站
# WARDEN_OUTBOUND_HOST_LIMIT=20/60     # 单 host：对同一站点保持礼貌
# WARDEN_OUTBOUND_MAX_CONCURRENCY=8    # 同时在飞的出站请求上限
# WARDEN_OUTBOUND_DAILY_QUOTA=2000     # 日配额；不设=不限（硬性停机上限由你显式决定）

# 凭证加密密钥材料：模型的 API Key 用它做 AES-GCM 加密，密文落进 credentials 表
# （租约元数据落 credential_leases 表，明文不落盘）。
# 只从环境变量读取，代码里不写死，也不接受调用方传入。
# 不设则用**进程内临时密钥**（真加密但进程退出即失效、密文再也解不开）并打警告；生产请每个部署一把。
# WARDEN_CREDENTIAL_KEY=换成一串强随机值

# 审计：设 1 启用，把每条请求记进 SQLite 的 audit_log 表（重启不丢）。
WARDEN_AUDIT=1

# Git：设一个 git 仓库目录，即可让 HTTP 服务暴露 git.apply_patch 工具。
# GIT_WORKDIR=D:/warden-agent


# CLI 要连的 Warden 服务地址（`warden chat` 等命令用），默认 http://127.0.0.1:8000。
# ⚠️ 这是「CLI 连哪个服务」，与下面 custom 模型的 WARDEN_BASE_URL 不是一回事，别混。
# WARDEN_SERVER_URL=http://127.0.0.1:8000

# ---- 傻瓜式接入「任意」OpenAI 兼容 API（零改源码，通用 custom 接入）----
# 想接 DeepSeek/OpenAI/智谱/百炼之外的任意兼容端点（自建网关 / Ollama / 硅基流动…）：
#   1) 设 provider=custom（或 build_agent(provider="custom")）
#   2) 填下面三项即可，不用改任何源码：
#
# ⚠️ 注意这里是 WARDEN_MODEL_API_KEY，**不是** WARDEN_API_KEY——
#    后者是上面那个「服务端鉴权密钥」，两者用途完全不同，绝不要混用。
#    （曾经同名过，会导致模型把你的服务端鉴权密钥发给第三方网关，已修。）
# ⚠️ 本机网关 / Ollama 这类不校验密钥的端点：填一个非空占位串即可，如 not-needed。
# WARDEN_MODEL_API_KEY=你的模型key
# WARDEN_BASE_URL=https://你的兼容端点/v1
# WARDEN_MODEL=你的模型名
#（custom 表示"通用接入"，built-in: deepseek/openai/zhipu/bailian 各自读自己的 *_API_KEY）
