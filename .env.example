# 复制这份文件为 `.env`，填上你自己的密钥。`.env` 已被 .gitignore 忽略，不会提交。

# 真实 DeepSeek 模型密钥（不设则用离线假模型）
DEEPSEEK_API_KEY=sk-你的密钥放这里

# HTTP 服务端口
PORT=8000

# ---- 阶段13 产品级 HTTP 服务 ----
# 认证：设一个服务端 API Key → 业务接口都要带 `Authorization: Bearer <key>`。
# 不设 = 本地开发开放，不鉴权（默认）。
WARDEN_API_KEY=sk-你的服务密钥

# 审计：设 1 启用，把每条请求记进 SQLite 的 audit_log 表（重启不丢）。
WARDEN_AUDIT=1

# Git：设一个 git 仓库目录，即可让 HTTP 服务暴露 git.apply_patch 工具。
# GIT_WORKDIR=D:/warden-agent


# ---- 傻瓜式接入「任意」OpenAI 兼容 API（零改源码，通用 custom 接入）----
# 想接 DeepSeek/OpenAI/智谱/百炼之外的任意兼容端点（自建网关 / Ollama / 硅基流动…）：
#   1) 设 provider=custom（或 build_agent(provider="custom")）
#   2) 填下面三项即可，不用改任何源码：
WARDEN_API_KEY=你的key
WARDEN_BASE_URL=https://你的兼容端点/v1
WARDEN_MODEL=你的模型名
#（custom 表示"通用接入"，built-in: deepseek/openai/zhipu/bailian 各自读自己的 *_API_KEY）
